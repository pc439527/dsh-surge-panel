{
  "name": "@local/dsh-surge-panel",
  "version": "1.1.2",
  "private": true,
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --test tests/*.test.mjs"
  },
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs/DETAIL.md",
    "docs/DETAIL.zh.md",
    "docs/preview.svg",
    "docs/preview.zh.svg",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
